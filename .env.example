# AWS SES delivery for the quote form (same key names as mna_automation).
# Copy to .env.local and fill in — .env.local is gitignored.
SES_AWS_REGION=ap-southeast-2
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# SES-verified sender identity.
QUOTE_FROM_EMAIL=
# Workshop inbox that receives quote requests.
QUOTE_TO_EMAIL=
